# Copy to .env. Dev-taugliche Defaults; der Compose-Stack (make dev) überschreibt
# die Hosts mit Service-Namen (postgres/redis/minio/mailpit/radicale) im Compose-File.
#
# Diese Datei listet **jede** Variable, die `backend/app/settings.py` liest
# (Präfix CUSTODE_) — aktuell 55. Auskommentiert heißt: für dev nicht nötig. Der Wert
# dahinter ist der Code-Default, wo es einen gibt, sonst ein brauchbarer Vorschlag
# (so bei den OPS-URLs und OTLP, deren Default `None` ist).
# Niemals echte Secrets eintragen — die gehören in die lokale, ungetrackte `.env`.

CUSTODE_ENV=dev
CUSTODE_DEBUG=true

# Brand (Anzeige nur über BRAND_NAME — nie hartcodieren)
CUSTODE_BRAND_NAME=Custode

# --- Logging ------------------------------------------------------------------
# CUSTODE_LOG_LEVEL=INFO
# JSON-Logs (structlog). Für lesbare lokale Logs auf false.
# CUSTODE_LOG_JSON=true

# --- Datastores (Host → Compose-exponierte Ports) -----------------------------
CUSTODE_DATABASE_URL=postgresql+asyncpg://custode_app:custode@localhost:5432/custode
# Owner/Superuser-URL für Migrationen (alembic):
CUSTODE_DATABASE_URL_ADMIN=postgresql+asyncpg://custode:custode@localhost:5432/custode
# Maint-Rolle (haushaltsübergreifende Lesepfade: Login/Refresh, Outbox-Dispatcher).
# Dev fällt ohne sie auf custode_app zurück; ab CUSTODE_ENV!=dev ist sie Pflicht (Startup-Guard).
CUSTODE_DATABASE_URL_MAINT=postgresql+asyncpg://custode_maint:custode_maint@localhost:5432/custode
# Betreiber-Konsole (ADR-0071): ops_readonly liest nur Aggregat-Views, ops_actions schreibt
# audit_log/Banner/Operatoren. Dev fällt ohne sie auf custode_app zurück — auf Prod Pflicht,
# sonst gilt die Betreiber-Grenze nur app-seitig, nicht auf DB-Ebene.
# CUSTODE_DATABASE_URL_OPS=postgresql+asyncpg://ops_readonly:ops_readonly@localhost:5432/custode
# CUSTODE_DATABASE_URL_OPS_ACTIONS=postgresql+asyncpg://ops_actions:ops_actions@localhost:5432/custode
CUSTODE_REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO) ---------------------------------------------------
CUSTODE_S3_ENDPOINT_URL=http://localhost:9000
CUSTODE_S3_BUCKET=custode
# Lokales Dateisystem statt S3 für Rezeptfotos; leer = Uploads aus (Null-Adapter).
# CUSTODE_STORAGE_DIR=
CUSTODE_S3_ACCESS_KEY=custode
CUSTODE_S3_SECRET_KEY=custode123

# --- Mail (Dev: mailpit; Web-UI auf http://localhost:8025) --------------------
CUSTODE_SMTP_HOST=localhost
CUSTODE_SMTP_PORT=1025
CUSTODE_SMTP_FROM=noreply@localhost
CUSTODE_SMTP_STARTTLS=false
# User/Passwort leer = mailpit ohne Auth. Auf Prod: der SMTP-Dienst des Betreibers (ADR-0027).
# CUSTODE_SMTP_USER=
# CUSTODE_SMTP_PASSWORD=

# --- Öffentliche Web-Origin (Links in E-Mails, OAuth-Redirect-URIs) -----------
CUSTODE_PUBLIC_BASE_URL=http://localhost:5173

# --- Observability ------------------------------------------------------------
# CUSTODE_SERVICE_NAME=custode-api
# Leer = kein OTLP-Export.
# CUSTODE_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Build-Info in der Ops-Konsole; am Deploy aus Image-Tag/Commit injiziert.
# CUSTODE_GIT_SHA=unknown
# CUSTODE_APP_VERSION=0.0.0

# --- Sessions (KONZEPT §8.5) --------------------------------------------------
# CUSTODE_ACCESS_TOKEN_TTL_S=900
# CUSTODE_REFRESH_TOKEN_TTL_S=2592000
# Operator-Session der Betreiber-Konsole (ADR-0072), 8 h.
# CUSTODE_OPS_SESSION_TTL_S=28800

# --- Hintergrundarbeit: Outbox, Reaper, Retention -----------------------------
# CUSTODE_OUTBOX_POLL_INTERVAL_S=1.0
# CUSTODE_OUTBOX_RETENTION_DAYS=30
# CUSTODE_SYNC_OPS_RETENTION_DAYS=30
# Papierkorb-Fenster: Tombstones werden danach hart gelöscht.
# CUSTODE_RETENTION_DAYS=30

# --- Login-Audit (ADR-0025) ---------------------------------------------------
# Die Edge (Cloudflare) setzt ein 2-Buchstaben-Länderkürzel; fehlt es, wird kein
# Land erfasst. Die IP selbst wird nie gespeichert.
# CUSTODE_GEO_COUNTRY_HEADER=CF-IPCountry

# --- Globale Feature-Flags (Betreiber-Ebene; Haushalts-Flags stehen in der DB) -
# JSON-Objekt, z. B. {"wearables": true}
# CUSTODE_FEATURE_FLAGS={}

# --- Wetter (KONZEPT §5.14, Graceful Enhancement) -----------------------------
# "open-meteo" = öffentliche API ohne Key, "null" = Basispfad ohne Anbieter.
# CUSTODE_WEATHER_PROVIDER=open-meteo
# CUSTODE_WEATHER_CACHE_TTL_S=3600

# --- Zuruf-LLM (Ollama, ADR-0068) ---------------------------------------------
# Aus = Null-Adapter; die App funktioniert vollständig ohne LLM. An: ein LOKALES
# Ollama reichert nur Freitextfelder an, die Struktur bleibt deterministisch.
# CUSTODE_OLLAMA_ENABLED=false
# CUSTODE_OLLAMA_URL=http://localhost:11434
# CUSTODE_OLLAMA_MODEL=llama3.2
# CUSTODE_OLLAMA_TIMEOUT_S=8.0

# --- CalDAV-Sync (P9-S3/S4, ADR-0079/0080) ------------------------------------
# Kill-Switch: aus = der 15-Minuten-Cron wird zum No-Op.
# CUSTODE_CALDAV_SYNC_ENABLED=true
# CUSTODE_CALDAV_TIMEOUT_S=10.0
# Dev: der SSRF-Guard würde das interne Compose-Netz (radicale:5232) blocken.
# Lockert NUR die Public-Address-Prüfung — Schema, Credential-Redirect-Origin-Sperre
# und Size/Time-Caps gelten weiter.
# CUSTODE_CALDAV_ALLOW_PRIVATE_URLS=true

# --- Wearables / Oura (P9-S5, ADR-0081) ---------------------------------------
# Kill-Switch je externem Adapter. Ohne Client-Credentials antwortet Verbinden 503
# wearables_disabled; Lesen und Löschen bestehender Verbindungen laufen weiter.
# CUSTODE_OURA_ENABLED=true
# CUSTODE_OURA_TIMEOUT_S=10.0
# Rohe Tageswerte werden nach so vielen Tagen gelöscht (KONZEPT §11, Art. 9).
# CUSTODE_WEARABLE_RAW_RETENTION_DAYS=90

# --- Feedback → GitHub Issues (ADR-0076, Graceful Enhancement) ----------------
# CUSTODE_GITHUB_API_URL=https://api.github.com
# CUSTODE_GITHUB_TIMEOUT_S=10.0

# --- Secrets: hier stehen NUR Platzhalter, echte Werte gehören in die lokale .env
# Server-seitige Credential-Verschlüsselung (ADR-0077). Erzeugen mit
#   uv --directory backend run python -c "from app.kernel.crypto import generate_key; print(generate_key())"
# Ohne Key bleiben CalDAV-Abos mit Zugangsdaten und Wearable-Tokens aus (503, nie ein Crash).
# Für `make dev` NICHT nötig: docker-compose.dev.yml setzt bei api/worker/scheduler eine
# feste Dev-Konstante. Diese Zeile brauchst du nur ohne Docker — oder auf einem Deployment.
# ACHTUNG: Ein Key-Wechsel macht alle bestehenden Chiffrate unlesbar.
# Nur gesetzt lassen, wenn ein Wert dahintersteht — leere Zeilen ans Blockende (gitleaks).
# CUSTODE_CRYPTO_KEY=
# CUSTODE_OURA_CLIENT_ID=
# CUSTODE_OURA_CLIENT_SECRET=
# Fine-grained PAT mit Issues: read/write, plus "owner/repo".
# CUSTODE_GITHUB_TOKEN=
# CUSTODE_GITHUB_REPO=
