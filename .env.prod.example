# Custode — secrets template for a server (ADR-0020; English guide: docs/operations.md).
#
# ./setup writes a complete .env with generated secrets (the quick start in the README). To fill
# it by hand instead: copy this file to .env and replace the values with real secrets.
# NEVER commit it — .env is in .gitignore. Generate values without URL-special characters, e.g.:
#   openssl rand -hex 24
#
# docker-compose.prod.yml reads this file as .env from the repository directory.

# Image version from GHCR (ghcr.io/juice-de-orange/custode-*): a release such as 0.2.0, or empty
# for `latest`. Where the image cannot be pulled, Compose builds it from this checkout.
CUSTODE_VERSION=

# Postgres superuser/owner. Migrations (alembic) run as this role.
POSTGRES_PASSWORD=change-me

# App role custode_app (subject to RLS, NOBYPASSRLS) — the runtime path.
APP_DB_PASSWORD=change-me

# Maintenance role custode_maint (cross-household jobs, narrow policies).
MAINT_DB_PASSWORD=change-me

# Operator console (ADR-0015/0071). ops_readonly reads ONLY aggregate views, ops_actions writes the
# audit_log and ops-owned tables — neither has any right on a fact table. If they stay empty, the
# console falls back to custode_app: the operator boundary then holds in the app only.
# NOTE: infra/postgres/init.prod.sh creates the roles only on the FIRST init (empty volume). On an
# existing stack create them once by hand — docs/MANUAL_TESTS.md.
OPS_DB_PASSWORD=change-me
OPS_ACTIONS_DB_PASSWORD=change-me

# Server-side credential encryption (ADR-0077): a Fernet key for third-party secrets the server
# must be able to USE (CalDAV passwords, wearable OAuth tokens) — unlike the client-side vault.
# Generate with:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api \
#       python -c "from app.kernel.crypto import generate_key; print(generate_key())"
# Empty => the dependent features stay off (503 crypto_unconfigured), never a crash.
# NOTE: changing the key makes ALL stored credentials unreadable — the affected subscriptions must
# then be entered again.
CUSTODE_CRYPTO_KEY=

# CalDAV (ADR-0079/0080). A kill switch per external adapter; turn ALLOW_PRIVATE_URLS on only when
# a self-hosted target (a Nextcloud on your NAS) must be reached in a private network.
CUSTODE_CALDAV_SYNC_ENABLED=true
CUSTODE_CALDAV_ALLOW_PRIVATE_URLS=false

# Sending e-mail via SMTP (ADR-0027). Full address + (app) password; NEVER commit.
# Leave CUSTODE_SMTP_HOST empty to switch e-mail off (null adapter; the app runs without sending —
# see README "Without SMTP" for what that means for password resets).
CUSTODE_SMTP_HOST=smtp.example.com
CUSTODE_SMTP_PORT=465
CUSTODE_SMTP_USER=noreply@example.com
CUSTODE_SMTP_PASSWORD=change-me
CUSTODE_SMTP_FROM=noreply@example.com
CUSTODE_SMTP_STARTTLS=false
# Public web origin for links in e-mails.
CUSTODE_PUBLIC_BASE_URL=https://custode.example.com

# Host name of the operator console (ADR-0072/0074): the second site block in the Caddyfile
# listens on exactly this host — over HTTP, TLS is terminated by the proxy or tunnel in front. The
# proxy must route ops.<domain> to custode-web:80 and pass the Host header through unchanged.
OPS_HOST=ops.example.com

# Imprint and privacy policy of THIS instance (docs/operations.md, "Legal pages"): a folder with
# imprint.md / privacy.md (optionally per language: imprint.en.md). The web container serves them
# under /legal/. Without files the app says the operator has not provided them.
# Empty => ./legal in the repository directory (ignored by git, `git pull` overwrites nothing).
CUSTODE_LEGAL_DIR=
# "Source code" link in the footer (AGPL-3.0 §13). Empty => the upstream repository. If you run a
# MODIFIED version, it must point at that version's source. Takes effect at the next `build` of
# the web image.
CUSTODE_SOURCE_URL=

# Host port of the api on 127.0.0.1 (health checks only; default 8080).
CUSTODE_API_PORT=

# Feedback forwarding to GitHub Issues (ADR-0076). Fine-grained PAT with Issues: read/write.
# Composed in the WORKER (outbox handler). Empty => null adapter, feedback stays in the app.
CUSTODE_GITHUB_TOKEN=
CUSTODE_GITHUB_REPO=

# Build info for the /ops console (§12). Without these values it shows unknown / 0.1.0.
CUSTODE_GIT_SHA=
CUSTODE_APP_VERSION=

# Trace export (OpenTelemetry). Empty => no export.
CUSTODE_OTLP_ENDPOINT=

# Oura wearable integration (ADR-0081). The operator registers ONE OAuth2 app; Oura switched off
# personal access tokens in Dec 2025. Enter the redirect URI there exactly as
#   <CUSTODE_PUBLIC_BASE_URL>/v1/wearables/oura/callback
# Empty => the integration is visibly off (503 wearables_disabled), everything else works.
# CUSTODE_OURA_ENABLED=false is the kill switch (the cron becomes a no-op).
CUSTODE_OURA_ENABLED=true
# Retention of raw values in days (KONZEPT §11, default 90). Runs even with the kill switch off.
CUSTODE_WEARABLE_RAW_RETENTION_DAYS=90
# Leave empty until the app is registered. These two lines sit at the end of the block on
# purpose: gitleaks' generic-api-key rule matches across line breaks and would pick up the value
# of the next assignment as a "secret" — with a blank line after them there is nothing to pick up.
CUSTODE_OURA_CLIENT_ID=
CUSTODE_OURA_CLIENT_SECRET=
