# Custode — Secret-Vorlage fuer einen Produktionsserver (ADR-0020).
#
# Kopiere nach <stack-dir>/.env und ersetze die Werte durch echte Secrets.
# NIE committen — .env ist in .gitignore. Erzeuge Werte ohne URL-Sonderzeichen,
# z. B.:  openssl rand -hex 24
#
# docker-compose.prod.yml laedt diese Datei via --env-file .env.

# Postgres-Superuser/Owner. Migrationen (alembic) laufen hierueber.
POSTGRES_PASSWORD=change-me

# App-Rolle custode_app (RLS-pflichtig, NOBYPASSRLS) — der Laufzeit-Pfad.
APP_DB_PASSWORD=change-me

# Maintenance-Rolle custode_maint (haushaltsuebergreifende Jobs, enge Policies).
MAINT_DB_PASSWORD=change-me

# Betreiber-Konsole (ADR-0015/0071). ops_readonly liest NUR Aggregat-Views, ops_actions schreibt
# das audit_log + ops-eigene Tabellen — beide ohne jedes Fachtabellen-Recht. Bleiben sie leer,
# faellt die Konsole auf custode_app zurueck: die Betreiber-Grenze gilt dann nur app-seitig.
# ACHTUNG: Die Rollen legt infra/postgres/init.prod.sh nur beim ERSTEN Init an (leeres
# Volume). Auf einem bestehenden Stack einmalig von Hand anlegen — docs/MANUAL_TESTS.md.
OPS_DB_PASSWORD=change-me
OPS_ACTIONS_DB_PASSWORD=change-me

# Server-seitige Credential-Verschluesselung (ADR-0077): Fernet-Schluessel fuer Fremd-Secrets,
# die der Server BENUTZEN muss (CalDAV-Passwoerter, spaeter Wearable-OAuth-Tokens) — anders als
# der clientseitige Vault. Erzeugen mit:
#   docker compose -f docker-compose.prod.yml run --rm api \
#       python -c "from app.kernel.crypto import generate_key; print(generate_key())"
# Leer => die abhaengigen Features bleiben aus (503 crypto_unconfigured), nie ein Crash.
# ACHTUNG: Ein Wechsel des Schluessels macht ALLE bereits gespeicherten Zugangsdaten
# unlesbar — die betroffenen Abos muessen dann neu eingegeben werden.
CUSTODE_CRYPTO_KEY=

# CalDAV (ADR-0079/0080). Kill-Switch je externem Adapter; ALLOW_PRIVATE_URLS nur einschalten,
# wenn ein selbst gehostetes Ziel (NAS-Nextcloud) im privaten Netz erreicht werden soll.
CUSTODE_CALDAV_SYNC_ENABLED=true
CUSTODE_CALDAV_ALLOW_PRIVATE_URLS=false

# E-Mail-Versand via SMTP (ADR-0027). Volle Adresse + (App-)Passwort; NIE committen.
# Leer lassen, um E-Mail zu deaktivieren (Null-Adapter; App laeuft ohne Versand).
# z. B. der SMTP-Dienst deines Anbieters (ADR-0027)
CUSTODE_SMTP_HOST=smtp.example.com
CUSTODE_SMTP_PORT=465
CUSTODE_SMTP_USER=noreply@deine-domain.tld
CUSTODE_SMTP_PASSWORD=change-me
CUSTODE_SMTP_FROM=noreply@deine-domain.tld
CUSTODE_SMTP_STARTTLS=false
# Oeffentliche Web-Origin fuer Links in E-Mails.
CUSTODE_PUBLIC_BASE_URL=https://custode.example.com

# Feedback-Weiterleitung an GitHub Issues (ADR-0076). Fine-grained PAT mit Issues: read/write.
# Wird im WORKER komponiert (Outbox-Handler). Leer => Null-Adapter, Feedback bleibt in-App.
CUSTODE_GITHUB_TOKEN=
CUSTODE_GITHUB_REPO=

# Build-Info fuer die /ops-Konsole (§12). Ohne diese Werte zeigt sie unknown / 0.0.0.
CUSTODE_GIT_SHA=
CUSTODE_APP_VERSION=

# Tracing-Export (OpenTelemetry -> Sentry). Leer => kein Export.
CUSTODE_OTLP_ENDPOINT=

# Oura-Wearable-Anbindung (ADR-0081). Der Betreiber registriert EINE OAuth2-App; Personal Access
# Tokens hat Oura im Dez 2025 abgeschaltet. Redirect-URI dort exakt eintragen als
#   <CUSTODE_PUBLIC_BASE_URL>/v1/wearables/oura/callback
# Leer => Anbindung sichtbar aus (503 wearables_disabled), alles andere laeuft.
# CUSTODE_OURA_ENABLED=false ist der Kill-Switch (Cron wird zum No-Op).
CUSTODE_OURA_ENABLED=true
# Rohwerte-Retention in Tagen (KONZEPT §11, Default 90). Laeuft auch bei Kill-Switch aus.
CUSTODE_WEARABLE_RAW_RETENTION_DAYS=90
# Leer lassen, bis die App registriert ist. Die beiden Zeilen stehen bewusst am Blockende:
# gitleaks' generic-api-key-Regel greift ueber Zeilengrenzen und wuerde den Wert der naechsten
# Zuweisung als "Secret" einsammeln — mit einer Leerzeile dahinter gibt es nichts einzusammeln.
CUSTODE_OURA_CLIENT_ID=
CUSTODE_OURA_CLIENT_SECRET=
